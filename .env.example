# ============ AI Medical Document Intelligence Platform ============
# Copy to .env and adjust. NEVER commit real secrets.

# --- Application ---
APP_NAME="MedIntel"
APP_ENV=dev                     # dev | staging | prod
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                  # DEBUG|INFO|WARNING|ERROR

# --- Database (SQLite for dev; PostgreSQL for prod/Docker) ---
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medintel

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Default demo credentials created on first run (dev only)
DEMO_USER_EMAIL=demo@medintel.local
DEMO_USER_PASSWORD=demo-password

# --- Uploads ---
MAX_UPLOAD_MB=30
STORAGE_ROOT=./storage
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
RETENTION_DAYS=90

# --- Processing ---
WORKER_CONCURRENCY=2            # parallel job threads
MAX_PAGES_PER_DOC=120
MAX_PAGES_OCR=40               # OCR pages cap (cost control)

# --- Embeddings ---
# local (TF-IDF, no deps) | openai (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=medintel-tfidf-v1
# OpenAI-compatible endpoint override (optional)
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=

# --- LLM (optional; system is fully functional without it) ---
# none        = deterministic extractive mode (offline, ~100ms answers)
# openai-compatible = any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=none
LLM_MODEL=none
# Free-tier Gemini example (get a key at https://aistudio.google.com → Get API key):
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=gemini-2.5-flash
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-key-here
# Works with Ollama too: LLM_API_BASE=http://localhost:11434/v1  LLM_MODEL=llama3.2
# LLM_API_BASE=
# LLM_API_KEY=

# --- OCR (optional) ---
OCR_PROVIDER=auto              # auto | none
TESSERACT_CMD=                 # optional explicit path to tesseract.exe

# --- Rate limiting ---
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_AUTH_PER_MIN=20
